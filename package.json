{
  "name": "dsh-agentlink",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Caller-side bridge from agent frameworks to the official DeepSeek Harness Web Host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hootandy321/dsh-Agentlink.git"
  },
  "homepage": "https://github.com/hootandy321/dsh-Agentlink#readme",
  "bugs": {
    "url": "https://github.com/hootandy321/dsh-Agentlink/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "agent-link",
    "agent-harness",
    "agent-collaboration"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "skill/",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "KNOWN_ISSUES.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-agentlink": "dist/index.js",
    "dsh-agentlink-doctor": "dist/doctor.js",
    "dsh-agentlink-setup": "dist/setup-codex.js",
    "dsh-agentlink-setup-claude": "dist/setup-claude-code.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "doctor": "tsx src/doctor.ts",
    "setup": "npm run build && node dist/setup-codex.js",
    "setup:claude": "npm run build && node dist/setup-claude-code.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "ws": "^8.18.3"
  }
}
